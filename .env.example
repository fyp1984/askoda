# 数据需求智能分析助手 · 环境变量样例
# 复制为 .env 后按需覆盖（.env 不入库）

# 网关对宿主机暴露的端口（容器内固定 8080；8080 已被 demo-server 占用，故用 18080）
GATEWAY_HOST_PORT=18080

# 构建 gateway 镜像使用的 pip 源
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 数据卷名（沿用既有卷，零迁移；如换了机器或重建了卷，改成实际的卷名即可）
WREN_PG_VOLUME=wren-docker_wren-pgdata
WREN_PG_VOLUME_B=wren-docker-b_wren-pgdata-b

# --- M2 新增 ---

# 网关自有元数据库（需求单 / 元数据字典 / 流转留痕）与附件存储的宿主机端口
ASSISTANT_PG_PORT=15434
ASSISTANT_MINIO_PORT=19000
ASSISTANT_MINIO_CONSOLE_PORT=19001

# FileBay 知识底座（RAGFlow）检索接口
# 容器内默认经 host.docker.internal 访问宿主机回环；若把网关接入 FileBay 网络，
# 可改为 http://ragflow-cpu:9380/api/v1 直连。
KNOWLEDGE_API_URL=http://host.docker.internal:19380/api/v1
# API Key 与数据集 ID 取值位置：
#   CheersAI-FileBay/deploy/knowledge/runtime/ragflow-binding/{api-key,dataset-id}
KNOWLEDGE_API_KEY=
KNOWLEDGE_DATASET_ID=
