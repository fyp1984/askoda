# 数据需求智能分析助手 · 环境变量样例
# 复制为 .env 后按需覆盖（.env 不入库）

# 网关对宿主机暴露的端口（容器内固定 8080；8080 已被 demo-server 占用，故用 18080）
GATEWAY_HOST_PORT=18080

# BFF 对宿主机暴露的端口（容器内固定 18081）。前端入口： http://127.0.0.1:18081/
BFF_HOST_PORT=18081

# 构建 gateway 镜像使用的 pip 源
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 数据卷名（沿用既有卷，零迁移；如换了机器或重建了卷，改成实际的卷名即可）
WREN_PG_VOLUME=wren-docker_wren-pgdata
WREN_PG_VOLUME_B=wren-docker-b_wren-pgdata-b

# --- M2 新增 ---

# 网关自有元数据库（需求单 / 元数据字典 / 流转留痕）与附件存储的宿主机端口
ASSISTANT_PG_PORT=15434
ASSISTANT_MINIO_PORT=19000
ASSISTANT_MINIO_CONSOLE_PORT=19001

# RAGFlow v0.26.4 原生检索接口
# 容器内默认经 host.docker.internal 访问宿主机回环。
# 知识底座唯一指向：不存在 FileBay 兜底分支，RAGFlow 不可用即如实报错。
# 注意：19380 入口目前是 nginx 代理，backend 仍是旧绑定栈内的 ragflow-cpu，
# 「RAGFlow 独立栈」在物理上尚未成立（见 P1-1）。
# ⇒ 换机器部署时，「知识检索」不可用；需先单独拉起那套旧绑定栈（见 README 5.3.3）。
KNOWLEDGE_API_URL=http://host.docker.internal:19380/api/v1

# ⚠️ 下面两项【必填】，不填则知识检索能力直接不可用。
#   照抄本文件（cp .env.example .env）后它们是空值，而空值不是「用默认值」——
#   网关 gateway/knowledge.py 会直接抛「未配置知识库 API Key」硬失败，
#   tools/ingest_knowledge.py 也会直接退出。
# 取值来源：RAGFlow 知识库侧的 API Key 与目标数据集 ID，二者必须成对且同属一个数据集。
#   建议做法：先起 RAGFlow（见 README 5.3.3），在 RAGFlow 界面建好数据集并生成 API Key，
#   再把 Key 与该数据集的 ID 回填到下面两行。
# 本文件是模板，不含也不应含真实凭据；真实值只写进不入库的 .env。
KNOWLEDGE_API_KEY=
KNOWLEDGE_DATASET_ID=

# 知识文档单文件上传上限（MB）。代码里 gateway/knowledge.py 读此项，默认 32。
# 前端 web/src/pages/PageKnowledge.tsx 的提示值与此一致，改这里要同步改前端。
KNOWLEDGE_MAX_UPLOAD_MB=32

# --- 本机备用 embedding（TEI）---

# 宿主机端口。仅在用本机 TEI 顶替远端 embedding 时才需要：
#   docker compose --profile local-embed up -d tei-embedding
# compose 里 tei-embedding 用 ${TEI_EMBEDDING_PORT:-18002}:80 映射，
# RAGFlow 容器侧走 host.docker.internal:该端口。
# 远端 embedding（100.103.240.78:18001）正常时，本机 TEI 默认不启动，
# docker compose config --services 里看不到它是正常的。
TEI_EMBEDDING_PORT=18002

# --- 数据库连接串（代码里已不再保留明文口令默认值）---

# 三个 DSN 一律**只从环境变量读**，代码里没有默认口令。
# docker-compose.yml 已为网关服务注入下列值，容器化启动**通常无需在此配置**；
# 下面两段只用于「不用 compose、直接在宿主跑网关」的场景。
#
# 为什么不留默认值：仓库里存着一份能直接连上库的口令，
# 交付对象就不该继承它；且默认值会掩盖配置错误——
# 变量名打错时会静默回退，表现为"连到了某个库但数据不对"，比直接报错难查。
# 缺失时的表现：`ASSISTANT_DB_DSN` 未配置 → 网关启动即抛带修复指引的 DBError；
# `WREN_PG_*_DSN` 未配置 → 仅影响 metadata_collect 元数据采集，其他功能不受影响。

# 网关自有元数据库（需求单 / 流转留痕 / 元数据字典 / 审计四表）
ASSISTANT_DB_DSN=postgresql://assistant:assistant@127.0.0.1:15434/assistant

# A/B 两个模拟业务库的元数据采集直连 DSN（仅 metadata_collect 用到）
WREN_PG_A_DSN=postgresql://test:test@127.0.0.1:15432/test
WREN_PG_B_DSN=postgresql://test:test@127.0.0.1:15433/retail
