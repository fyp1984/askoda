须在答复后重跑一次 analyze。所以这里内部串行做「答复 → 重跑分析」，\n并把两段结果一起返回，前端可直接对比槽位是否已被回填。","operationId":"confirm_api_v1_demand__demand_id__confirm_post","parameters":[{"name":"demand_id","in":"path","required":true,"schema":{"type":"string","title":"Demand Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfirmIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"title":"Response Confirm Api V1 Demand  Demand Id  Confirm Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/demand/{demand_id}/sql":{"post":{"tags":["取数"],"summary":"Sql Generate","operationId":"sql_generate_api_v1_demand__demand_id__sql_post","parameters":[{"name":"demand_id","in":"path","required":true,"schema":{"type":"string","title":"Demand Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SqlIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"title":"Response Sql Generate Api V1 Demand  Demand Id  Sql Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/demand/{demand_id}/sql/execute":{"post":{"tags":["取数"],"summary":"Sql Execute","operationId":"sql_execute_api_v1_demand__demand_id__sql_execute_post","parameters":[{"name":"demand_id","in":"path","required":true,"schema":{"type":"string","title":"Demand Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SqlExecuteIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"title":"Response Sql Execute Api V1 Demand  Demand Id  Sql Execute Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/compon